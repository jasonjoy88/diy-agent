# 必填：监控的本地目录（绝对路径）
WATCH_DIR=E:\sync-watch
# 网盘：baidu 或 quark（只对配置的网盘弹窗登录）
DRIVE=quark
# 扫描间隔（分钟）
SCAN_INTERVAL_MINUTES=30
# 运行时间窗（小时，含 START，不含 END）
START_HOUR=8
END_HOUR=23
# 网盘内目标根目录
REMOTE_ROOT=/pan-sync
# 同名冲突策略（当前仅支持 skip：跳过并保留本地）
CONFLICT_POLICY=skip
# 上传分片大小（MB）
CHUNK_SIZE_MB=4
# 文件稳定判定秒数（size/mtime 持续不变多久才上传）
STABLE_SECONDS=60
# 跳过的目录名前缀（逗号分隔）。默认 `_`：_pool_smoke / _probe_dj 等非歌手目录不上传
SKIP_DIR_PREFIXES=_
