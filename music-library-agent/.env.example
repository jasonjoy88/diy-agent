# ===== 火山方舟 Ark（LLM 决策，可选；缺失时降级为确定性规则） =====
ARK_API_KEY=
ARK_MODEL=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ===== 网易云 cookie（可选；不填则网易云直链大概率拿不到 MP3，仅 yt-dlp 可用） =====
# 指向 cookie 文件，或指向目录（自动找 wangyiyun.txt / netease_cookies.txt / netease.txt / cookies.txt）
# 文件内容支持：浏览器 Cookie 头「a=1; b=2」或 Netscape cookies.txt
NETEASE_COOKIE_FILE=
# 兼容旧配置：也可直接把 Cookie 字符串写在这里（文件优先）
NETEASE_COOKIE=

# ===== Agent 行为 =====
MUSIC_OUTPUT_ROOT=music
# 下载并发：B 站风控敏感，默认 1；稳定后可调高（如 4）
MUSIC_CONCURRENCY=1
# 并发模型：thread=多线程（默认，适合网络 IO）| process=多进程（隔离 yt-dlp/ffmpeg）
MUSIC_POOL=thread
MUSIC_TOP_N=30

MUSIC_BITRATE=320k
MUSIC_FFMPEG_BIN=tools/ffmpeg/bin
MUSIC_CHECKPOINT_DB=.music-agent/checkpoints.sqlite
MUSIC_ENABLE_YTDLP=1
MUSIC_ENABLE_NETEASE=1
MUSIC_ENABLE_QQ=1
MUSIC_ENABLE_KUGOU=1
MUSIC_ENABLE_KUWO=1
MUSIC_ENABLE_QISHUI=1
MUSIC_ENABLE_MIGU=1
MUSIC_ENABLE_APPLE=1
# Apple / iTunes 店面优先（TW/HK/JP/US/CN）；空则自动回退
MUSIC_APPLE_STOREFRONT=

# ===== yt-dlp / B 站（缓解 HTTP 412） =====
# 支持：1) Netscape cookies.txt  2) 浏览器复制的「a=1; b=2」Cookie 头（自动转换）
# 注意：.env 里同一 KEY 不要先写空行再写路径（空值会挡住后面的路径；现已允许非空覆盖空值）
MUSIC_YTDLP_COOKIE_FILE=
# 或从本机浏览器导入（cookie 文件未配置时生效），例：chrome / edge / firefox / chrome:Default
MUSIC_YTDLP_COOKIES_FROM_BROWSER=
# YouTube 回退默认开启（B 站找不到时再搜 YouTube）；无代理/不可达时设为 0 关闭
MUSIC_YTDLP_ENABLE_YOUTUBE=1
# YouTube 请求专用代理（B 站等国内源始终直连，不受影响）
# 例：socks5://127.0.0.1:10808 或 http://127.0.0.1:10809
# 留空则自动探测系统代理（标准代理环境变量 / Windows 注册表）
MUSIC_YTDLP_PROXY=
# 下载间隔 / 单次请求间隔（秒），降低 412
MUSIC_YTDLP_SLEEP_INTERVAL=2
MUSIC_YTDLP_SLEEP_REQUESTS=1

# ===== QQ 音乐 cookie（下载常用；检索可不配） =====
MUSIC_QQ_COOKIE_FILE=
MUSIC_QQ_COOKIES_FROM_BROWSER=
# 也可用：python main.py login --platform qq

# ===== 其它平台 cookie（login 命令写入 .cookies/ 后可指向） =====
MUSIC_KUGOU_COOKIE_FILE=
MUSIC_KUWO_COOKIE_FILE=
MUSIC_QISHUI_COOKIE_FILE=
MUSIC_MIGU_COOKIE_FILE=
MUSIC_APPLE_COOKIE_FILE=

# ===== 瞬时失败重试（412/超时/连接重置等；VIP/资源不存在不重试） =====
MUSIC_FETCH_RETRIES=2
MUSIC_FETCH_RETRY_BACKOFF=1.5
